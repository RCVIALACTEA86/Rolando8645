PORT=3000
KEY_SECRET=SecretCaracolRace
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Saldo inicial asignado al registrar un usuario
INITIAL_BALANCE=0

# SnailPay (pasarela de pagos simulada)
SNAILPAY_TEST_CARD=1234123412341234
SNAILPAY_TEST_EXPIRY=12/26
SNAILPAY_TEST_CVV=543
SNAILPAY_LATENCY_MS=900

# Tarjetas que disparan cada error de transacción (requerimiento 2.3.2)
SNAILPAY_CARD_BAD_NUMBER=4000000000000001
SNAILPAY_CARD_BAD_DATE=4000000000000002
SNAILPAY_CARD_BAD_CVV=4000000000000003
SNAILPAY_CARD_INSUFFICIENT=4000000000000004
SNAILPAY_CARD_HIGH_RISK=4000000000000005
SNAILPAY_CARD_CALL_AUTHORIZE=4000000000000006

# Tarjeta que simula un error del sistema (requerimiento 2.3.3)
SNAILPAY_CARD_SYSTEM_ERROR=5000000000000001
